{
    "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
    "name": "CORALS_Telecommunication",
    "description": "A communication framework supporting Rx and Tx message handlers.",
    "authors": {
        "name": "Logan Ruddick",
        "email": "Logan@Ruddicks.net"
    },
    "frameworks": "arduino",
    "platforms": "*",
    "headers": [
        "Telecommunicator.hpp",
        "RxMessageBase.tpp",
        "TxMessageBase.tpp"
    ],
    "dependencies": [
        {
            "name": "CORALS_Configuration"
        },
        {
            "name": "CORALS_DataStructures"
        }
    ],
    "build": {
        "includeDir": "Include",
        "srcDir": "Source"
    }
}